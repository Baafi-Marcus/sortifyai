# SortifyAI Backend Configuration
# ================================

# Neon PostgreSQL Database Connection URL
# Replace with your connection string from the Neon Console: https://console.neon.tech
# Example: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sortifyai-xxxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# OpenRouter AI Keys (for natural language instruction parsing)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# Twilio Credentials (Optional, for SMS/WhatsApp admin notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FEEDBACK_NOTIFICATION_PHONE=
